<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Emoji/ícone do gênero -->
        <TextView
            android:id="@+id/tvEmoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="28sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Título do filme -->
            <TextView
                android:id="@+id/tvTituloFilme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título do Filme"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1B2A4A"/>

            <!-- Gênero e tipo -->
            <TextView
                android:id="@+id/tvGeneroTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ação • Filme"
                android:textSize="13sp"
                android:textColor="#888888"/>

            <!-- Plataforma -->
            <TextView
                android:id="@+id/tvPlataforma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Netflix"
                android:textSize="12sp"
                android:textColor="#E8541A"/>

        </LinearLayout>

        <!-- Botão de detalhes -->
        <Button
            android:id="@+id/btnDetalhes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver"
            android:textSize="12sp"
            android:backgroundTint="#E8541A"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>