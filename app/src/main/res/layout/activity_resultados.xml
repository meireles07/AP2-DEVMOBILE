<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Cabeçalho laranja -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E8541A"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvOla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olá, Fulano!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Separamos essas recomendações para você"
            android:textSize="14sp"
            android:textColor="#FFDDCC"/>

    </LinearLayout>

    <!-- Informações do perfil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFF5F0">

        <TextView
            android:id="@+id/tvPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬 Filme • Ação • Netflix"
            android:textSize="13sp"
            android:textColor="#E8541A"/>

    </LinearLayout>

    <!-- Título da lista -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recomendações"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1B2A4A"
        android:padding="16dp"/>

    <!-- RecyclerView: lista de filmes recomendados (componente gráfico 9) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFilmes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>

    <!-- Botões na parte de baixo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💾 Salvar"
            android:backgroundTint="#1B2A4A"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnHistorico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 Histórico"
            android:backgroundTint="#E8541A"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>