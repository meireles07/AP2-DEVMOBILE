<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho com emoji grande -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#1B2A4A"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmojiDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬"
                android:textSize="72sp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Título do filme -->
            <TextView
                android:id="@+id/tvTituloDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título do Filme"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1B2A4A"
                android:layout_marginBottom="8dp"/>

            <!-- Gênero e tipo -->
            <TextView
                android:id="@+id/tvGeneroDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ação • Filme"
                android:textSize="15sp"
                android:textColor="#888888"
                android:layout_marginBottom="4dp"/>

            <!-- Plataforma -->
            <TextView
                android:id="@+id/tvPlataformaDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disponível na Netflix"
                android:textSize="14sp"
                android:textColor="#E8541A"
                android:layout_marginBottom="24dp"/>

            <!-- Botão assistir trailer — Intent implícita -->
            <Button
                android:id="@+id/btnAssistirTrailer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▶ Assistir Trailer"
                android:backgroundTint="#E8541A"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"/>

            <!-- Botão compartilhar — Intent implícita -->
            <Button
                android:id="@+id/btnCompartilhar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔗 Compartilhar"
                android:backgroundTint="#1B2A4A"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"/>

            <!-- Botão voltar -->
            <Button
                android:id="@+id/btnVoltar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="← Voltar"
                android:backgroundTint="#DDDDDD"
                android:textColor="#1B2A4A"
                android:textSize="16sp"
                android:padding="16dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>