<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNomeHistorico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1B2A4A"/>

        <TextView
            android:id="@+id/tvDetalhesHistorico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ação • Filme • Netflix"
            android:textSize="13sp"
            android:textColor="#888888"/>

        <TextView
            android:id="@+id/tvDataHistorico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10/06/2026"
            android:textSize="12sp"
            android:textColor="#E8541A"/>

        <Button
            android:id="@+id/btnDeletar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑️ Remover"
            android:textSize="12sp"
            android:backgroundTint="#FF4444"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>